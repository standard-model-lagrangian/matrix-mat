{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AuditTaskCardSchema_Section9",
  "type": "object",
  "required": [
    "task_id",
    "claim_reference",
    "verdict",
    "preregistration",
    "sensitivity_ranges",
    "bias_direction",
    "provenance_hashes",
    "execution_metadata",
    "metrics",
    "summary"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^T[0-9]{2}[a-z]?$"
    },
    "claim_reference": {
      "type": "string",
      "description": "Specific paper section, table, figure, or quotation under audit."
    },
    "verdict": {
      "type": "string",
      "enum": ["SUPPORTED", "WEAKENED", "CONTRADICTED", "UNCHECKABLE"]
    },
    "preregistration": {
      "type": "object",
      "required": ["hypothesis", "primary_metric", "decision_rule"],
      "properties": {
        "hypothesis": { "type": "string" },
        "primary_metric": { "type": "string" },
        "decision_rule": { "type": "string" },
        "parameters": { "type": "object" }
      }
    },
    "sensitivity_ranges": {
      "type": "object",
      "description": "Explored parameter ranges, kernels, noise models, or thresholds."
    },
    "bias_direction": {
      "type": "string",
      "enum": [
        "conservative",
        "anti-conservative",
        "neutral",
        "favors_authors",
        "penalizes_authors"
      ]
    },
    "provenance_hashes": {
      "type": "object",
      "required": ["inputs", "outputs", "script"],
      "properties": {
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string" },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string" },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        },
        "script": {
          "type": "object",
          "required": ["path", "sha256"],
          "properties": {
            "path": { "type": "string" },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        }
      }
    },
    "execution_metadata": {
      "type": "object",
      "required": [
        "execution_time_seconds",
        "timestamp_utc",
        "seed",
        "hardware",
        "python_version"
      ],
      "properties": {
        "execution_time_seconds": { "type": "number", "minimum": 0 },
        "timestamp_utc": { "type": "string" },
        "seed": { "type": "integer" },
        "hardware": { "type": "string" },
        "python_version": { "type": "string" }
      }
    },
    "metrics": {
      "type": "object",
      "description": "Key numerical audit statistics, p-values, coverage, and ratios."
    },
    "summary": {
      "type": "string",
      "description": "Concise 1-3 sentence narrative finding."
    }
  }
}
